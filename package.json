{
  "name": "paonplan",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.ts --demo",
    "db:owner": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.ts",
    "test:integration": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --test tests/operations.integration.ts",
    "db:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/local-db.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  }
}
